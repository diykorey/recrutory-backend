<?xml version="1.0" encoding="UTF-8"?>
<mappings xmlns="http://dozer.sourceforge.net"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://dozer.sourceforge.net
          http://dozer.sourceforge.net/schema/beanmapping.xsd">

    <configuration>
        <stop-on-errors>true</stop-on-errors>
        <wildcard>true</wildcard>
    </configuration>

    <mapping wildcard="true">
        <class-a>com.kandidato.model.dto.input.VacancyIn</class-a>
        <class-b>com.kandidato.persistence.entity.Vacancy</class-b>
        <field-exclude>
            <a>tags</a>
            <b>tags</b>
        </field-exclude>
    </mapping>

    <mapping wildcard="true">
        <class-a>com.kandidato.persistence.entity.Vacancy</class-a>
        <class-b>com.kandidato.model.dto.VacancyDTO</class-b>
    </mapping>

    <mapping wildcard="true">
        <class-a>com.kandidato.persistence.entity.Flow</class-a>
        <class-b>com.kandidato.model.dto.FlowDTO</class-b>
    </mapping>

    <mapping wildcard="true">
        <class-a>com.kandidato.model.dto.input.FlowActionIn</class-a>
        <class-b>com.kandidato.persistence.entity.FlowAction</class-b>
        <field-exclude>
            <a>flowId</a>
            <b>flow</b>
        </field-exclude>
    </mapping>

    <mapping wildcard="true">
        <class-a>com.kandidato.persistence.entity.FlowAction</class-a>
        <class-b>com.kandidato.model.dto.FlowActionDTO</class-b>
        <field>
            <a>flow.id</a>
            <b>flowId</b>
        </field>
    </mapping>
    <mapping wildcard="true">
        <class-a>com.kandidato.model.dto.input.FieldIn</class-a>
        <class-b>com.kandidato.persistence.entity.TimelineField</class-b>
    </mapping>
    <mapping wildcard="true">
        <class-a>com.kandidato.persistence.entity.Candidate</class-a>
        <class-b>com.kandidato.model.dto.CandidateDTO</class-b>
    </mapping>
    <mapping wildcard="true">
        <class-a>com.kandidato.persistence.entity.Candidate</class-a>
        <class-b>com.kandidato.model.dto.BaseCandidateDTO</class-b>
    </mapping>
    <mapping wildcard="true">
        <class-a>com.kandidato.persistence.entity.TimelineField</class-a>
        <class-b>com.kandidato.model.dto.TimelineFieldDTO</class-b>
    </mapping>
    <mapping wildcard="true">
        <class-a>com.kandidato.persistence.entity.TimelineFieldType</class-a>
        <class-b>com.kandidato.model.dto.TimelineFieldTypeDTO</class-b>
    </mapping>
</mappings>